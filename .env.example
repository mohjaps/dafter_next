# PostgreSQL connection (Neon / Vercel Postgres / Supabase / local). POSTGRES_URL is also accepted.
# Prefer the provider's *pooled* URL on Vercel.
DATABASE_URL=postgres://daftar:daftar@localhost:5432/daftar

# Required in production: 32+ random characters (e.g. `openssl rand -hex 32`). Signs session and CSRF cookies.
SESSION_SECRET=

# SMS provider for login codes (HTTPS). The API POSTs {"phone","code"} with "Authorization: Bearer <token>".
OTP_PROVIDER_URL=
OTP_PROVIDER_TOKEN=

# Local development only: return the OTP code in the API response and show it on the login screen.
OTP_EXPOSE_DEVELOPMENT_CODE=true
# DANGEROUS: also allow the line above in a production build (anyone could log in as any shop). Demos only.
# OTP_ALLOW_INSECURE_DEMO_CODE=true

# Optional
# DATABASE_POOL_MAX=5
# DATABASE_PREPARE=false        # set true only for a direct (non-pooled) connection
# COOKIE_SECURE=true            # defaults to true in production builds
# NEXT_PUBLIC_API_BASE_URL=/api/v1
