{
  "name": "daftar",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "vercel-build": "node scripts/migrate.mjs --optional && node scripts/bootstrap-admin.mjs --optional && next build",
    "start": "next start",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "test": "node --test \"tests/unit/*.test.mjs\"",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate.mjs",
    "db:bootstrap-admin": "node --env-file-if-exists=.env.local scripts/bootstrap-admin.mjs",
    "postinstall": "node scripts/copy-scalar.mjs"
  },
  "dependencies": {
    "@scalar/api-reference": "^1.77.0",
    "@scalar/nextjs-api-reference": "^0.12.16",
    "decimal.js": "^10.6.0",
    "lucide-react": "^1.70.0",
    "next": "^16.4.5",
    "postgres": "^4.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.5",
    "typescript": "^6.0.3"
  }
}
